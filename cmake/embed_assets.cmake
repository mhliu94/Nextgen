# Generates a C++ source file embedding every file under NG_ASSET_ROOT.
# Invoked at build time: cmake -DNG_ASSET_ROOT=... -DNG_OUTPUT=... -P embed_assets.cmake
file(GLOB_RECURSE _assets RELATIVE "${NG_ASSET_ROOT}" "${NG_ASSET_ROOT}/*")
list(SORT _assets)
set(_out "// Generated by cmake/embed_assets.cmake. Do not edit.\n")
string(APPEND _out "#include \"web/assets.h\"\n#include <cstddef>\n#include <cstdint>\nnamespace ng::assets {\nnamespace {\n")
set(_index 0)
set(_table "")
foreach(_rel IN LISTS _assets)
  file(READ "${NG_ASSET_ROOT}/${_rel}" _hex HEX)
  string(LENGTH "${_hex}" _hexlen)
  math(EXPR _bytes "${_hexlen} / 2")
  # Turn "4142" into "0x41,0x42,"
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes_list "${_hex}")
  string(APPEND _out "const unsigned char asset_${_index}[] = {${_bytes_list}0x00};\n")
  string(APPEND _table "  {\"${_rel}\", asset_${_index}, ${_bytes}},\n")
  math(EXPR _index "${_index} + 1")
endforeach()
string(APPEND _out "} // namespace\n")
string(APPEND _out "const Asset kAssets[] = {\n${_table}  {nullptr, nullptr, 0}\n};\n")
string(APPEND _out "const std::size_t kAssetCount = ${_index};\n}\n")
file(WRITE "${NG_OUTPUT}" "${_out}")
