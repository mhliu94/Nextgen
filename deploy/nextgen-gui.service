# systemd unit for the KTrader next-generation control server.
#
#   sudo cp deploy/nextgen-gui.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nextgen-gui
#   journalctl -u nextgen-gui -f
#
# Adjust User/WorkingDirectory to the account and checkout that owns the build, and put
# environment overrides (KAFKA_*, UI_*, ACCOUNT_DASHBOARD_CONFIG) in /etc/nextgen-gui.env.
[Unit]
Description=KTrader next-generation trading control server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nextgen-gui
EnvironmentFile=-/etc/nextgen-gui.env
ExecStart=/home/ubuntu/nextgen-gui/scripts/start_nextgen_gui.sh --foreground
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536
# Binding ports 80/443 without running as root:
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
